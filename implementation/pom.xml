    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.pointertrace.siglet</groupId>
        <artifactId>siglet-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.github.pointertrace.siglet.impl</groupId>
    <artifactId>siglet</artifactId>
    <packaging>jar</packaging>
    <name>siglet Implementation</name>
    <description>Implementation of an engine that runs siglets</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <log4j2-version>2.21.1</log4j2-version>
