    </licenses>
    <developers>
        <developer>
            <name>Osvaldo Pina</name>
            <email>pointertrace@gmail.com</email>
            <url>https://github.com/pointer-trace</url>
        </developer>
    </developers>
    <dependencies>
        <dependency>
            <groupId>io.github.pointertrace.siglet.api</groupId>
            <artifactId>siglet-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.pointertrace.siglet.parser</groupId>
